            <option value="nl">ჰოლანდიური (Dutch)</option>
            <option value="sv">შვედური (Swedish)</option>
            <option value="no">ნორვეგიული (Norwegian)</option>
            <option value="fi">ფინური (Finnish)</option>
            <option value="cs">ჩეხური (Czech)</option>
            <option value="hu">უნგრული (Hungarian)</option>
            <option value="ro">რუმინული (Romanian)</option>
            <option value="bg">ბულგარული (Bulgarian)</option>
            <option value="he">ებრაული (Hebrew)</option>
            <option value="hi">ინდური/ჰინდი (Hindi)</option>
