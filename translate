            <option value="ru">რუსული (Russian)</option>
            <option value="de">გერმანული (German)</option>
            <option value="fr">ფრანგული (French)</option>
            <option value="es">ესპანური (Spanish)</option>
            <option value="it">იტალიური (Italian)</option>
            <option value="tr">თურქული (Turkish)</option>
            <option value="uk">უკრაინული (Ukrainian)</option>
            <option value="zh">ჩინური (Chinese)</option>
            <option value="ja">იაპონური (Japanese)</option>
